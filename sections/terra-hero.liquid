{{ 'hero.css' | asset_url | stylesheet_tag }}

{%- assign proof_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'proof' -%}
    {%- assign proof_count = proof_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<section class="terra-hero terra-hero--{{ section.settings.image_position }}">
  <div class="terra-hero__copy">
    {% content_for 'block', type: 'heading', id: 'heading' %}

    <div class="terra-hero__actions">
      {% if section.settings.primary_label != blank %}
        <a class="terra-hero__button terra-hero__button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a class="terra-hero__button terra-hero__button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
      {% endif %}
    </div>

    {% if proof_count > 0 %}
      <div class="terra-hero__proof" aria-label="Studio details">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  </div>

  <div class="terra-hero__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'terra-hero__image', widths: '600, 800, 1100, 1400, 1800', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}
    {% else %}
      {{ 'collection-1' | placeholder_svg_tag: 'terra-hero__placeholder' }}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Terra hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "right", "options": [{ "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The autumn collection" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Tactile stoneware\nshaped by hand" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Organic curves, textured glazes, and timeless forms crafted to bring warmth and\neveryday beauty to your morning ritual." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop collection" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Watch the process" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "blocks": [{ "type": "heading" }, { "type": "proof" }],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Terra hero",
      "blocks": [
        { "type": "heading", "id": "heading", "static": true, "settings": { "heading_tag": "h1", "heading_size_desktop": "display", "heading_size_mobile": "display", "width": "custom", "custom_width": 650, "alignment": "left" } },
        { "type": "proof", "settings": { "heading": "100%", "text": "Lead-Free Clay" } },
        { "type": "proof", "settings": { "heading": "Batch No. 04", "text": "Now Live" } }
      ]
    }
  ]
}
{% endschema %}