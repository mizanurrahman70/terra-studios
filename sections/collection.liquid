{% style %}
  #TerraCollection-{{ section.id }} { --terra-collection-bg: {{ section.settings.background }}; --terra-collection-text: {{ section.settings.text_color }}; --terra-collection-muted: {{ section.settings.muted_color }}; --terra-collection-accent: {{ section.settings.accent_color }}; --terra-collection-padding: {{ section.settings.padding }}px; }
{% endstyle %}

{{ 'featured-products.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}

{% liquid
  assign filter_layout = 'row'
  if section.settings.filter_layout != blank
    assign filter_layout = section.settings.filter_layout
  endif
%}

<section id="TerraCollection-{{ section.id }}" class="terra-collection">
  <header class="terra-collection__header">
    {% if section.settings.eyebrow != blank %}<p class="terra-collection__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ collection.title | escape }}</h1>
    {% if collection.description != blank %}<div class="terra-collection__description">{{ collection.description }}</div>{% endif %}
  </header>

  <div class="terra-collection__layout{% if section.settings.show_filters %} terra-collection__layout--{{ filter_layout }}{% endif %}">
    {% if section.settings.show_filters %}
      {% render 'terra-collection-filters', layout: filter_layout %}
    {% endif %}

    <div class="terra-collection__content">
      {% if section.settings.show_filters %}
        <div class="terra-collection__toolbar">
          <p class="terra-collection__count">{{ collection.products_count }} {{ 'collections.products' | t }}</p>
          <form class="terra-collection__sort" action="{{ collection.url }}" method="get" data-terra-sort-form>
            <label class="visually-hidden" for="TerraSort-{{ section.id }}">{{ 'collections.sort_by' | t }}</label>
            <select id="TerraSort-{{ section.id }}" name="sort_by" data-terra-sort>
              {% for option in collection.sort_options %}
                <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
              {% endfor %}
            </select>
          </form>
        </div>
      {% endif %}

      {% paginate collection.products by section.settings.products_per_page %}
        {% if collection.products_count > 0 %}
          <div class="terra-collection__grid">
            {% for product in collection.products %}
              {% liquid
                assign is_sale = false
                if product.compare_at_price > product.price
                  assign is_sale = true
                endif
              %}
              <article class="terra-product-card">
                <div class="terra-product-card__media">
                  {% if is_sale and section.settings.show_badges %}<span class="terra-product-card__badge terra-product-card__badge--sale">Save</span>{% endif %}
                  {% if product.available == false and section.settings.show_badges %}<span class="terra-product-card__badge terra-product-card__badge--soldout">Sold out</span>{% endif %}
                  {% if product.available and product.tags contains 'New' and section.settings.show_badges %}<span class="terra-product-card__badge terra-product-card__badge--new">New</span>{% endif %}
                  <a href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                    {% if product.featured_image != blank %}
                      {{ product.featured_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 25vw, (min-width: 750px) 50vw, 80vw', loading: 'lazy', alt: product.featured_image.alt }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {% endif %}
                  </a>
                  {% if section.settings.show_quick_add and product.available and product.has_only_default_variant %}
                    {% form 'product', product, class: 'terra-product-card__form' %}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit">Quick add <span aria-hidden="true">+</span><span class="visually-hidden"> {{ product.title | escape }}</span></button>
                    {% endform %}
                  {% endif %}
                </div>
                <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                <p class="terra-product-card__price{% if is_sale %} terra-product-card__price--sale{% endif %}">
                  <span>{{ product.price | money }}</span>{% if is_sale %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
                </p>
              </article>
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <nav class="terra-collection__pagination" aria-label="Pagination">
              {% if paginate.previous %}<a href="{{ paginate.previous.url }}" class="terra-collection__page terra-collection__page--prev" aria-label="Previous page">&larr;</a>{% endif %}
              {% for part in paginate.parts %}
                {% if part.is_link %}
                  {{ part.title | link_to: part.url, class: 'terra-collection__page' }}
                {% elsif part.title == paginate.current_page %}
                  <span class="terra-collection__page terra-collection__page--current" aria-current="page">{{ part.title }}</span>
                {% else %}
                  <span class="terra-collection__page terra-collection__page--gap">{{ part.title }}</span>
                {% endif %}
              {% endfor %}
              {% if paginate.next %}<a href="{{ paginate.next.url }}" class="terra-collection__page terra-collection__page--next" aria-label="Next page">&rarr;</a>{% endif %}
            </nav>
          {% endif %}
        {% else %}
          <p class="terra-collection__empty">No products in this collection yet.</p>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
</section>

<script>
  (function () {
    var filterForm = document.querySelector('[data-terra-filter-form]');
    var sortForm = document.querySelector('[data-terra-sort-form]');
    if (!sortForm) return;
    var sort = sortForm.querySelector('[data-terra-sort]');
    if (!sort) return;

    sort.addEventListener('change', function () {
      if (filterForm) {
        var params = new URLSearchParams(new FormData(filterForm));
        params.set('sort_by', sort.value);
        window.location.href = filterForm.action + '?' + params.toString();
      } else {
        sortForm.submit();
      }
    });

    if (filterForm) {
      var sortField = filterForm.querySelector('[data-terra-sort-field]');
      filterForm.addEventListener('submit', function () {
        if (sortField) sortField.value = sort.value;
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_filters", "label": "Show product filters", "default": true },
    { "type": "select", "id": "filter_layout", "label": "Filter layout", "options": [
      { "value": "row", "label": "Row (top bar)" },
      { "value": "column", "label": "Column (sidebar)" }
    ], "default": "row" },
    { "type": "checkbox", "id": "show_badges", "label": "Show sale, sold-out, and New badges", "default": true },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add for single-variant products", "default": true },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 30, "max": 150, "step": 2, "unit": "px", "default": 88 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#2b2925" },
    { "type": "color", "id": "muted_color", "label": "Muted text color", "default": "#77716b" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#c4592e" }
  ]
}
{% endschema %}