{% style %}
  #TerraVideo-{{ section.id }} {
    --terra-video-bg: {{ section.settings.background }};
    --terra-video-text: {{ section.settings.text_color }};
    --terra-video-muted: {{ section.settings.muted_color }};
    --terra-video-accent: {{ section.settings.accent_color }};
    --terra-video-padding: {{ section.settings.padding }}px;
    --terra-video-width: {{ section.settings.max_width }}px;
  }
{% endstyle %}

{{ 'video.css' | asset_url | stylesheet_tag }}

<section id="TerraVideo-{{ section.id }}" class="terra-video"{% if section.settings.heading != blank or section.settings.text != blank %} aria-labelledby="TerraVideoHeading-{{ section.id }}"{% endif %}>
  <div class="terra-video__inner">
    {% if section.settings.heading != blank %}
      <h2 id="TerraVideoHeading-{{ section.id }}" class="terra-video__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="terra-video__text">{{ section.settings.text | escape | newline_to_br }}</div>
    {% endif %}

    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: class: 'terra-video__player', image_size: '1100x', autoplay: section.settings.autoplay, loop: section.settings.loop, controls: section.settings.controls, muted: section.settings.muted, preload: 'metadata' }}
    {% elsif section.settings.video_url != blank %}
      <div class="terra-video__embed">
        <iframe
          src="{{ section.settings.video_url | video_embed_url }}"
          title="{{ section.settings.video_url | escape }}"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          frameborder="0"
        ></iframe>
      </div>
    {% else %}
      <div class="terra-video__placeholder">
        {% if section.settings.poster != blank %}
          {{ section.settings.poster | image_url: width: 1600 | image_tag: widths: '800, 1200, 1600', sizes: '100vw', loading: 'lazy', alt: section.settings.heading }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Inside the kiln room" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A short film on the firing that turns raw clay into dinnerware." },
    { "type": "header", "content": "Media" },
    { "type": "video", "id": "video", "label": "Video", "info": "Uploaded from your store library. Takes priority over an external URL." },
    { "type": "video_url", "id": "video_url", "label": "YouTube or Vimeo link", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Shown while no video is selected." },
    { "type": "header", "content": "Playback" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    { "type": "checkbox", "id": "muted", "label": "Muted (required for autoplay)", "default": true },
    { "type": "checkbox", "id": "controls", "label": "Show controls", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Media width", "min": 600, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 30, "max": 160, "step": 2, "unit": "px", "default": 88 },
    { "type": "color", "id": "background", "label": "Background", "default": "#f8f7f4" },
    { "type": "color", "id": "text_color", "label": "Heading color", "default": "#2b2925" },
    { "type": "color", "id": "muted_color", "label": "Text color", "default": "#77716b" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#c4592e" }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}