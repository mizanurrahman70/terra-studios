{% style %}
  #TerraGallery-{{ section.id }} {
    --terra-gallery-bg: {{ section.settings.background }};
    --terra-gallery-text: {{ section.settings.text_color }};
    --terra-gallery-muted: {{ section.settings.muted_color }};
    --terra-gallery-accent: {{ section.settings.accent_color }};
    --terra-gallery-padding: {{ section.settings.padding }}px;
    --terra-gallery-cols: {{ section.settings.columns }};
    --terra-gallery-gap: {{ section.settings.gap }}px;
  }
{% endstyle %}

{{ 'gallery.css' | asset_url | stylesheet_tag }}

<section id="TerraGallery-{{ section.id }}" class="terra-gallery">
  <div class="terra-gallery__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="terra-gallery__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="terra-gallery__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="terra-gallery__list">
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            <figure class="terra-gallery__item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}">
              {% endif %}
                {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '400, 600, 900, 1400, 1600', sizes: '(min-width: 1000px) 33vw, (min-width: 600px) 50vw, 100vw', loading: 'lazy', alt: block.settings.caption }}
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
              {% if block.settings.caption != blank %}
                <figcaption>{{ block.settings.caption | escape }}</figcaption>
              {% endif %}
            </figure>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p class="terra-gallery__empty">Add images to build your gallery.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Terra gallery",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From dust to dinnerware" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 20 },
    { "type": "header", "content": "Spacing & colors" },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 30, "max": 160, "step": 2, "unit": "px", "default": 88 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Heading color", "default": "#2b2925" },
    { "type": "color", "id": "muted_color", "label": "Caption color", "default": "#77716b" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#c4592e" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Kiln glaze study" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Terra gallery",
      "blocks": [
        { "type": "image", "settings": { "caption": "Kiln glaze study" } },
        { "type": "image", "settings": { "caption": "Wheel throwing, batch 05" } },
        { "type": "image", "settings": { "caption": "Fired & ready" } }
      ]
    }
  ]
}
{% endschema %}