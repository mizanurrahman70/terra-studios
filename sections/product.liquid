{% liquid
  assign is_sale = false
  if product.compare_at_price > product.price
    assign is_sale = true
  endif
  assign product_form_id = 'TerraProductForm-' | append: section.id
%}

{% style %}
  #TerraProduct-{{ section.id }} { --terra-product-bg: {{ section.settings.background }}; --terra-product-text: {{ section.settings.text_color }}; --terra-product-muted: {{ section.settings.muted_color }}; --terra-product-accent: {{ section.settings.accent_color }}; --terra-product-btn: {{ section.settings.button_color }}; --terra-product-btn-text: {{ section.settings.button_text_color }}; --terra-product-padding: {{ section.settings.padding }}px; }
{% endstyle %}

{% capture terra_product_data %}[{%- for variant in product.variants -%}{"id":{{ variant.id }},"options":{{ variant.options | json }},"price":{{ variant.price | money | json }},"compare":{{ variant.compare_at_price | money | json }},"available":{{ variant.available }} }{% unless forloop.last %},{% endunless %}{%- endfor -%}]{% endcapture %}

<section id="TerraProduct-{{ section.id }}" class="terra-product">
  <div class="terra-product__grid">
    <div class="terra-product__media">
      {% if product.images.size > 0 %}
        <div class="terra-product__main">
          {% assign main_image = product.images.first %}
          {{ main_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '600, 900, 1200', sizes: '(min-width: 1000px) 55vw, 100vw', alt: main_image.alt, data-terra-main: true }}
        </div>
        {% if product.images.size > 1 %}
          <div class="terra-product__thumbs" role="list" aria-label="Product gallery">
            {% for image in product.images %}
              <a class="terra-product__thumb{% if forloop.first %} terra-product__thumb--active{% endif %}" href="{{ image | image_url: width: 1200 }}" data-terra-thumb aria-label="{{ image.alt | default: product.title | escape }}">
                {{ image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', alt: image.alt }}
              </a>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
    </div>

    <div class="terra-product__info">
      {% if section.settings.show_vendor and product.vendor != blank %}<p class="terra-product__vendor">{{ product.vendor | escape }}</p>{% endif %}
      <h1 class="terra-product__title">{{ product.title | escape }}</h1>

      <div class="terra-product__price{% if is_sale %} terra-product__price--sale{% endif %}">
        <span class="terra-product__price-now" data-terra-price>{{ product.price | money }}</span>
        {% if is_sale %}<s class="terra-product__price-compare" data-terra-compare>{{ product.compare_at_price | money }}</s><span class="terra-product__price-save" data-terra-save>Save</span>{% endif %}
      </div>

      {% if section.settings.show_short and product.metafields.descriptors.subtitle != blank %}
        <p class="terra-product__short">{{ product.metafields.descriptors.subtitle }}</p>
      {% endif %}

      {% if product.description != blank %}
        <div class="terra-product__description">{{ product.description }}</div>
      {% endif %}

      {% form 'product', product, class: 'terra-product__form', id: product_form_id %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-terra-variant-id>
        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <div class="terra-product__option">
              <label class="terra-product__label" for="TerraOption-{{ section.id }}-{{ forloop.index }}">{{ option.name | escape }}</label>
              <select class="terra-product__variant-select" id="TerraOption-{{ section.id }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" data-terra-variant-select>
                {% for value in option.values %}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value | escape }}</option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        {% endunless %}

        <div class="terra-product__actions">
          {% if section.settings.show_quantity_selector %}
            <div class="terra-product__quantity">
              <label class="terra-product__label" for="TerraQty-{{ section.id }}">Quantity</label>
              <input id="TerraQty-{{ section.id }}" data-terra-qty type="number" name="quantity" min="1" value="1">
            </div>
          {% endif %}

          <button class="terra-product__add" type="submit" name="add" data-terra-add {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to cart{% else %}Sold out{% endif %}
          </button>
        </div>

        {% if section.settings.show_buy_now %}
          <button class="terra-product__buy" type="submit" name="checkout" data-terra-buy-now {% unless product.available %}disabled{% endunless %}>
            Buy now
          </button>
        {% endif %}

        {% if section.settings.show_payment_button %}
          <div class="terra-product__payment">{{ form | payment_button }}</div>
        {% endif %}
      {% endform %}

      {% if section.blocks.size > 0 %}
        <div class="terra-product__more">
          {% for block in section.blocks %}
            <details class="terra-product__row" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }}</summary>
              <div class="terra-product__row-body">{{ block.settings.content }}</div>
            </details>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('TerraProduct-{{ section.id }}');
    if (!root) return;

    var data = {{ terra_product_data }};
    var selects = root.querySelectorAll('[data-terra-variant-select]');
    var priceEl = root.querySelector('[data-terra-price]');
    var compareEl = root.querySelector('[data-terra-compare]');
    var saveEl = root.querySelector('[data-terra-save]');
    var addBtn = root.querySelector('[data-terra-add]');
    var idInput = root.querySelector('[data-terra-variant-id]');
    if (selects.length && priceEl) {
      function findVariant() {
        var values = Array.prototype.map.call(selects, function (s) { return s.value; });
        return data.find(function (v) { return values.every(function (val, i) { return v.options[i] === val; }); });
      }
      function render() {
        var v = findVariant();
        if (!v) return;
        priceEl.textContent = v.price;
        if (compareEl) {
          var onSale = v.compare && v.compare !== v.price;
          compareEl.textContent = v.compare;
          compareEl.hidden = !onSale;
          if (priceEl.parentElement) priceEl.parentElement.classList.toggle('terra-product__price--sale', onSale);
          if (saveEl) saveEl.hidden = !onSale;
        }
        if (addBtn) {
          addBtn.disabled = !v.available;
          addBtn.textContent = v.available ? 'Add to cart' : 'Sold out';
        }
        if (idInput) idInput.value = v.id;
      }
      selects.forEach(function (s) { s.addEventListener('change', render); });
      render();
    }

    var mainImg = root.querySelector('[data-terra-main]');
    var thumbs = root.querySelectorAll('[data-terra-thumb]');
    if (mainImg && thumbs.length) {
      thumbs.forEach(function (t) {
        t.addEventListener('click', function (e) {
          e.preventDefault();
          mainImg.src = t.href;
          thumbs.forEach(function (x) { x.classList.toggle('terra-product__thumb--active', x === t); });
        });
      });
    }

    var qtyInput = root.querySelector('[data-terra-qty]');
    var buyNow = root.querySelector('[data-terra-buy-now]');
    if (buyNow && data.length) {
      buyNow.addEventListener('click', function (e) {
        e.preventDefault();
        var qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;
        var v = selects.length ? findVariant() : data[0];
        if (!v) return;
        buyNow.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ items: [{ id: v.id, quantity: qty }] })
        }).then(function (r) { return r.json(); })
          .then(function () { window.location.href = '/checkout'; })
          .catch(function () { buyNow.disabled = false; });
      });
    }
  })();
</script>

{% stylesheet %}
  .visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.terra-product{background:var(--terra-product-bg,#fff);color:var(--terra-product-text,#2b2925);grid-column:1/-1;padding:var(--terra-product-padding,88px) clamp(20px,5vw,82px)}.terra-product__grid{display:grid;gap:clamp(28px,5vw,70px);grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);margin:0 auto;max-width:1300px}.terra-product__media{background:#eee8df}.terra-product__main{aspect-ratio:1/1.06;overflow:hidden}.terra-product__main img,.terra-product__main svg{height:100%;object-fit:cover;width:100%}.terra-product__thumbs{display:flex;flex-wrap:wrap;gap:10px;padding:12px}.terra-product__thumb{aspect-ratio:1;background:#eee8df;border:1px solid transparent;display:block;height:64px;overflow:hidden;text-decoration:none;width:64px}.terra-product__thumb--active{border-color:var(--terra-product-accent,#c4592e)}.terra-product__thumb img{height:100%;object-fit:cover;width:100%}.terra-product__info{max-width:560px}.terra-product__vendor{color:var(--terra-product-accent,#c4592e);font-size:10px;font-weight:800;letter-spacing:.02em;margin:0 0 10px;text-transform:uppercase}.terra-product__title{font-size:clamp(28px,3vw,42px);font-weight:800;letter-spacing:-.05em;line-height:1.05;margin:0 0 18px}.terra-product__price{align-items:baseline;display:flex;gap:10px;margin:0 0 22px}.terra-product__price-now{font-size:22px;font-weight:800}.terra-product__price--sale .terra-product__price-now{color:var(--terra-product-accent,#c4592e)}.terra-product__price-compare{color:var(--terra-product-muted,#77716b);font-size:16px;font-weight:400}.terra-product__price-save{background:var(--terra-product-btn,#c4592e);color:#fff;font-size:9px;font-weight:800;padding:3px 6px;text-transform:uppercase}.terra-product__short{color:var(--terra-product-accent,#c4592e);font-size:14px;font-weight:600;margin:0 0 18px}.terra-product__description{color:var(--terra-product-muted,#77716b);font-size:14px;line-height:1.7;margin:0 0 28px}.terra-product__description p{margin:0 0 12px}.terra-product__form{align-items:stretch;display:flex;flex-direction:column;gap:18px}.terra-product__option{display:grid;gap:8px}.terra-product__label{font-size:10px;font-weight:800;letter-spacing:.02em;text-transform:uppercase}.terra-product__option select,.terra-product__quantity input{border:1px solid #e3ded8;border-radius:0;color:var(--terra-product-text,#2b2925);font-size:14px;min-height:46px;padding:0 14px;width:100%}.terra-product__option select:focus-visible,.terra-product__quantity input:focus-visible{outline:1px solid var(--terra-product-accent,#c4592e)}.terra-product__actions{align-items:end;display:flex;gap:14px}.terra-product__quantity{display:grid;gap:8px}.terra-product__quantity input{width:90px}.terra-product__add{background:transparent;border:1px solid var(--terra-product-btn,#c4592e);color:var(--terra-product-btn,#c4592e);cursor:pointer;flex:1;font-size:12px;font-weight:800;letter-spacing:.02em;min-height:46px;padding:0 18px;text-transform:uppercase}.terra-product__add:hover,.terra-product__add:focus-visible{background:var(--terra-product-btn,#c4592e);color:var(--terra-product-btn-text,#fff);filter:none}.terra-product__buy{background:var(--terra-product-btn,#c4592e);border:1px solid var(--terra-product-btn,#c4592e);color:var(--terra-product-btn-text,#fff);cursor:pointer;font-size:12px;font-weight:800;letter-spacing:.02em;min-height:46px;padding:0 18px;text-transform:uppercase;width:100%}.terra-product__buy:hover,.terra-product__buy:focus-visible{filter:brightness(.9);outline:none}.terra-product__add[disabled],.terra-product__buy[disabled]{cursor:not-allowed;opacity:.5}.terra-product__more{margin-top:10px}.terra-product__row{border-top:1px solid #e3ded8}.terra-product__row:last-child{border-bottom:1px solid #e3ded8}.terra-product__row summary{align-items:center;cursor:pointer;display:flex;font-size:10px;font-weight:800;justify-content:space-between;letter-spacing:.02em;list-style:none;padding:18px 0;text-transform:uppercase}.terra-product__row summary::-webkit-details-marker{display:none}.terra-product__row summary::after{color:var(--terra-product-accent,#c4592e);content:"+";font-size:18px;font-weight:400}.terra-product__row[open] summary::after{content:"\2013"}.terra-product__row summary:focus-visible{outline:1px solid var(--terra-product-accent,#c4592e);outline-offset:4px}.terra-product__row-body{color:var(--terra-product-muted,#77716b);font-size:14px;line-height:1.7;padding:0 0 18px}.terra-product__row-body p{margin:0 0 10px}.terra-product__payment{margin-top:4px}.terra-product__payment .shopify-payment-button__button--unbranded{margin-top:8px;min-height:46px}@media(max-width:900px){.terra-product{padding-block:max(50px,var(--terra-product-padding,88px))}.terra-product__grid{grid-template-columns:1fr}.terra-product__info{max-width:none}.terra-product__media{order:-1}}@media(max-width:520px){.terra-product__actions{flex-direction:column;align-items:stretch}.terra-product__quantity input{width:100%}}
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "checkbox", "id": "show_short", "label": "Show short subtitle", "default": true },
    { "type": "checkbox", "id": "show_quantity_selector", "label": "Show quantity selector", "default": true },
    { "type": "checkbox", "id": "show_buy_now", "label": "Show Buy now button", "default": true },
    { "type": "checkbox", "id": "show_payment_button", "label": "Show dynamic checkout button", "default": false },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 30, "max": 150, "step": 2, "unit": "px", "default": 88 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#2b2925" },
    { "type": "color", "id": "muted_color", "label": "Muted text color", "default": "#77716b" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#c4592e" },
    { "type": "header", "content": "Button" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#c4592e" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "collapsible_row",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "More info" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add shipping, care and materials details here.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}