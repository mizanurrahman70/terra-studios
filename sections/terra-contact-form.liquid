{% style %}
  #TerraContact-{{ section.id }} {
    --terra-contact-bg: {{ section.settings.background }};
    --terra-contact-text: {{ section.settings.text_color }};
    --terra-contact-muted: {{ section.settings.muted_color }};
    --terra-contact-accent: {{ section.settings.accent_color }};
    --terra-contact-padding: {{ section.settings.padding }}px;
  }
{% endstyle %}

{{ 'contact-form.css' | asset_url | stylesheet_tag }}

<section id="TerraContact-{{ section.id }}" class="terra-contact">
  <div class="terra-contact__inner">
    <div class="terra-contact__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="terra-contact__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="terra-contact__text">{{ section.settings.text | escape | newline_to_br }}</div>
      {% endif %}
    </div>

    <div class="terra-contact__form">
      {%- assign contact_form_id = 'TerraContactForm-' | append: section.id -%}
      {% form 'contact', id: contact_form_id %}
        {% if form.posted_successfully? %}
          <p class="terra-contact__status terra-contact__status--success" tabindex="-1" autofocus>
            {{ section.settings.success_message | escape }}
          </p>
        {% elsif form.errors %}
          <p class="terra-contact__status terra-contact__status--error" tabindex="-1" autofocus>
            {{ form.errors.translated_fields.body | capitalize }} {{ form.errors.messages.body }}
          </p>
        {% endif %}

        <div class="terra-contact__row">
          <div class="terra-contact__field">
            <label for="ContactFormName-{{ section.id }}">Name</label>
            <input
              type="text"
              id="ContactFormName-{{ section.id }}"
              name="contact[name]"
              value="{{ form.name | escape }}"
              autocomplete="name"
              required
            >
          </div>
          <div class="terra-contact__field">
            <label for="ContactFormEmail-{{ section.id }}">Email</label>
            <input
              type="email"
              id="ContactFormEmail-{{ section.id }}"
              name="contact[email]"
              value="{{ form.email | escape }}"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              required
            >
          </div>
        </div>

        {% if section.settings.show_phone %}
          <div class="terra-contact__field">
            <label for="ContactFormPhone-{{ section.id }}">Phone number</label>
            <input
              type="tel"
              id="ContactFormPhone-{{ section.id }}"
              name="contact[phone]"
              value="{{ form.phone | escape }}"
              autocomplete="tel"
            >
          </div>
        {% endif %}

        <div class="terra-contact__field">
          <label for="ContactFormMessage-{{ section.id }}">Message</label>
          <textarea
            id="ContactFormMessage-{{ section.id }}"
            name="contact[body]"
            rows="6"
            required
          >{{ form.body | escape }}</textarea>
        </div>

        <button type="submit" class="terra-contact__button">
          {{ section.settings.button_label | escape }}
        </button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Say hello" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Questions about\na batch?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Wholesale, commissions, and press are always welcome. We reply within two business days." },
    { "type": "checkbox", "id": "show_phone", "label": "Show phone number field", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for reaching out. We'll get back to you soon." },
    { "type": "header", "content": "Spacing & colors" },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 30, "max": 160, "step": 2, "unit": "px", "default": 96 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Heading color", "default": "#2b2925" },
    { "type": "color", "id": "muted_color", "label": "Text color", "default": "#77716b" },
    { "type": "color", "id": "accent_color", "label": "Button color", "default": "#c4592e" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}