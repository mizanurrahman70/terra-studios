{% liquid
  assign announcement_bg = section.settings.background
  assign announcement_fg = section.settings.text_color
%}

{{ 'announcement.css' | asset_url | stylesheet_tag }}

{% style %}
  #TerraAnnouncement-{{ section.id }} {
    --terra-announcement-bg: {{ announcement_bg }};
    --terra-announcement-fg: {{ announcement_fg }};
    --terra-announcement-duration: {{ section.settings.scroll_speed }}s;
    --terra-announcement-max-width: {{ section.settings.max_width }}px;
    --terra-announcement-pad-top: {{ section.settings.padding_top }}px;
    --terra-announcement-pad-bottom: {{ section.settings.padding_bottom }}px;
    --terra-announcement-pad-inline: {{ section.settings.padding_inline }}px;
    --terra-announcement-margin-bottom: {{ section.settings.margin_bottom }}px;
    --terra-announcement-margin-top: {{ section.settings.margin_top }}px;
    --terra-announcement-margin-top: {{ section.settings.margin_top }}px;
    --terra-announcement-margin-bottom: {{ section.settings.margin_bottom }}px;
  }
{% endstyle %}

{% if section.settings.show_announcement %}
  <section class="terra-announcement{% if section.settings.enable_scrolling %} terra-announcement--scroll{% endif %}" id="TerraAnnouncement-{{ section.id }}" aria-label="Store announcement">
    <div class="terra-announcement__inner{% if section.settings.full_width %} terra-announcement__inner--full{% endif %}">
      {% if section.settings.enable_scrolling %}
        <div class="terra-announcement__track" role="marquee">
          {% for i in (1..4) %}
            <p class="terra-announcement__item">{{ section.settings.announcement_text | escape }}</p>
          {% endfor %}
        </div>
      {% else %}
        <p class="terra-announcement__item terra-announcement__item--static">{{ section.settings.announcement_text | escape }}</p>
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Terra announcement",
  "settings": [
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement", "default": true },
    { "type": "text", "id": "announcement_text", "label": "Announcement", "default": "Free shipping on domestic orders over $150 — handcrafted in small batches" },
    { "type": "checkbox", "id": "enable_scrolling", "label": "Enable scrolling", "default": true },
    { "type": "range", "id": "scroll_speed", "label": "Scroll speed (seconds per loop)", "min": 1, "max": 10, "step": 1, "unit": "s", "default": 10 },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "range", "id": "max_width", "label": "Maximum content width", "min": 800, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_inline", "label": "Padding left/right", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": -100, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": -100, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#c4592e" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
  ],
  "disabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}