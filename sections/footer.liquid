{% style %}
  #TerraFooter-{{ section.id }} { --terra-footer-bg: {{ section.settings.background }}; --terra-footer-text: {{ section.settings.text_color }}; --terra-footer-muted: {{ section.settings.muted_color }}; --terra-footer-accent: {{ section.settings.accent_color }}; --terra-footer-padding: {{ section.settings.padding }}px; }
{% endstyle %}

{{ 'footer.css' | asset_url | stylesheet_tag }}

<footer id="TerraFooter-{{ section.id }}" class="terra-footer">
  <div class="terra-footer__grid">
    <div class="terra-footer__brand">
      <h2 class="terra-footer__wordmark">Terra <span>Studios</span></h2>
      {% if section.settings.statement != blank %}
        <p class="terra-footer__statement">{{ section.settings.statement | escape }}</p>
      {% endif %}
      {% for block in section.blocks %}
        {% if block.type == 'social' %}
          <a class="terra-footer__social-link" href="{{ block.settings.url }}" aria-label="{{ block.settings.icon | capitalize }}" {{ block.shopify_attributes }}>
            {% case block.settings.icon %}
              {% when 'instagram' %}<svg viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.9.2 2.3.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.3.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.9-.4 2.3-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.3.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.9-.2-2.3-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.3-.1-1.2-.1-1.6-.1-4.8s0-3.6.1-4.8c.1-1.2.2-1.9.4-2.3.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.3-.4 1.2-.1 1.6-.1 4.8-.1Zm0 2c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1Zm0 3.3a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Zm0 2a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Zm5.7-3.2a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6Z"/></svg>
              {% when 'facebook' %}<svg viewBox="0 0 24 24"><path d="M14 8.5V6.8c0-.8.7-1 1.1-1H16V3h-2.2c-1.8 0-3.3 1.2-3.3 3.2v2.3H8.5V11h2v9h3.5v-9h2.4l.4-2.5H14Z"/></svg>
              {% when 'x' %}<svg viewBox="0 0 24 24"><path d="M3.5 3h5.6l4 5.7L18.2 3h2.3l-6.3 7.5L21 21h-5.6l-4.3-6.1L6 21H3.7l6.6-7.9L3.5 3Z"/></svg>
              {% when 'pinterest' %}<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-3.7 19.3c-.1-.8-.2-2 0-2.9l1.2-5.1s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.9 1.6 1.9 1.9 0 3.3-2 3.3-4.9 0-2.5-1.8-4.3-4.4-4.3-3 0-4.8 2.3-4.8 4.6 0 .9.4 1.9.8 2.4l.1.9c.6-.8 1-1.9 1-1.9s-1.9-.2-1.9-2.2c0-1.8 1.3-3.5 3.4-3.5 1.9 0 3.3 1.3 3.3 3.1 0 2.1-1.3 3.7-3.1 3.7-.6 0-1.2-.3-1.4-.7l-.4 1.5c-.1.5-.4 1.2-.6 1.6.4.1.9.2 1.4.2a10 10 0 1 0 0-20Z"/></svg>
              {% when 'tiktok' %}<svg viewBox="0 0 24 24"><path d="M16.6 3c.3 2 1.5 3.5 3.4 3.8v3c-1.3 0-2.5-.4-3.5-1.1v5.1c0 3.7-2.7 6-5.8 6a5.6 5.6 0 0 1-5.4-6.6c.3-2.5 2.4-4.3 5-4.3.3 0 .6 0 .8.1v3.1a2.8 2.8 0 0 0-.9-.1c-1.6 0-2.7 1.2-2.7 2.8 0 1.6 1.2 2.8 2.9 2.8 1.7 0 2.9-1.2 2.9-3.2V3h3.3Z"/></svg>
              {% when 'youtube' %}<svg viewBox="0 0 24 24"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12c0 1.6.1 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.3-1.6.4-3.2.4-4.8s-.1-3.2-.4-4.8ZM10 15.2V8.8l5.2 3.2-5.2 3.2Z"/></svg>
            {% endcase %}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <nav class="terra-footer__col" aria-label="{{ section.settings.shop_heading }}">
      <h3>{{ section.settings.shop_heading | escape }}</h3>
      {% if section.settings.shop_menu != blank and section.settings.shop_menu.links.size > 0 %}
        {% for link in section.settings.shop_menu.links %}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {% if block.type == 'link' and block.settings.column == 'shop' %}
            <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </nav>

    <nav class="terra-footer__col" aria-label="{{ section.settings.studio_heading }}">
      <h3>{{ section.settings.studio_heading | escape }}</h3>
      {% if section.settings.studio_menu != blank and section.settings.studio_menu.links.size > 0 %}
        {% for link in section.settings.studio_menu.links %}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {% if block.type == 'link' and block.settings.column == 'studio' %}
            <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </nav>

    <nav class="terra-footer__col" aria-label="{{ section.settings.care_heading }}">
      <h3>{{ section.settings.care_heading | escape }}</h3>
      {% if section.settings.care_menu != blank and section.settings.care_menu.links.size > 0 %}
        {% for link in section.settings.care_menu.links %}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {% if block.type == 'link' and block.settings.column == 'care' %}
            <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </nav>
  </div>

  <div class="terra-footer__bottom">
    <p class="terra-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | escape }}</p>

    <div class="terra-footer__legal">
      {% for policy in shop.policies %}
        <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
      {% endfor %}
    </div>

    {% if section.settings.show_cart_link %}
      <a class="terra-footer__cart-link" href="{{ routes.cart_url }}">
        {% if cart != empty %}{{ cart.item_count }}{% endif %} items in cart
      </a>
    {% endif %}

    {% if section.settings.show_payment_icons %}
      <div class="terra-footer__payment">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "statement", "label": "Brand statement", "default": "Tactile stoneware, shaped by hand. Small-batch ceramics pressed, glazed, and vitrified in our local workshop for everyday ritual." },
    { "type": "text", "id": "shop_heading", "label": "Shop column heading", "default": "Shop" },
    { "type": "text", "id": "studio_heading", "label": "Studio column heading", "default": "Studio" },
    { "type": "text", "id": "care_heading", "label": "Customer care column heading", "default": "Customer Care" },
    { "type": "link_list", "id": "shop_menu", "label": "Shop menu", "info": "When selected, replaces the Shop column links below." },
    { "type": "link_list", "id": "studio_menu", "label": "Studio menu", "info": "When selected, replaces the Studio column links below." },
    { "type": "link_list", "id": "care_menu", "label": "Customer care menu", "info": "When selected, replaces the Customer care column links below." },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "Terra Studios. Handcrafted in small batches." },
    { "type": "checkbox", "id": "show_policy_links", "label": "Show store policies", "default": true },
    { "type": "checkbox", "id": "show_cart_link", "label": "Show cart link", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 40, "max": 170, "step": 2, "unit": "px", "default": 84 },
    { "type": "color", "id": "background", "label": "Background", "default": "#332e29" },
    { "type": "color", "id": "text_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "color", "id": "muted_color", "label": "Text color", "default": "#b9b2a9" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#c4592e" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Link text", "default": "All Ceramics" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "select", "id": "column", "label": "Column", "default": "shop", "options": [{ "value": "shop", "label": "Shop" }, { "value": "studio", "label": "Studio" }, { "value": "care", "label": "Customer care" }] }
      ]
    },
    {
      "type": "social",
      "name": "Social icon",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "instagram", "options": [{ "value": "instagram", "label": "Instagram" }, { "value": "facebook", "label": "Facebook" }, { "value": "x", "label": "X" }, { "value": "pinterest", "label": "Pinterest" }, { "value": "tiktok", "label": "TikTok" }, { "value": "youtube", "label": "YouTube" }] },
        { "type": "url", "id": "url", "label": "Social link" }
      ]
    }
  ],
  "max_blocks": 40
}
{% endschema %}