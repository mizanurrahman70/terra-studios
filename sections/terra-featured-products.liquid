{% style %}
  #TerraFeaturedProducts-{{ section.id }} { --terra-featured-bg: {{ section.settings.background }}; --terra-featured-text: {{ section.settings.text_color }}; --terra-featured-muted: {{ section.settings.muted_color }}; --terra-featured-accent: {{ section.settings.accent_color }}; --terra-featured-padding: {{ section.settings.padding }}px; }
{% endstyle %}

{{ 'featured-products.css' | asset_url | stylesheet_tag }}

<section id="TerraFeaturedProducts-{{ section.id }}" class="terra-featured-products" data-terra-products-slider data-autoplay="{{ section.settings.enable_autoplay }}" data-interval="{{ section.settings.autoplay_speed }}">
  <div class="terra-featured-products__heading">
    <div>
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    </div>
    <div class="terra-featured-products__heading-actions">
      {% if section.settings.button_label != blank %}
        <a class="terra-featured-products__view-all" href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% elsif section.settings.collection != blank %}{{ section.settings.collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ section.settings.button_label | escape }}</a>
      {% endif %}
      {% if section.settings.show_nav %}
        <nav class="terra-featured-products__nav" aria-label="Featured products">
          <button type="button" class="terra-featured-products__arrow" data-terra-products-prev aria-label="Previous products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
          </button>
          <button type="button" class="terra-featured-products__arrow" data-terra-products-next aria-label="Next products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
        </nav>
      {% endif %}
    </div>
  </div>

  {%- liquid
    assign has_products = false
    if section.settings.collection != blank and section.settings.collection.products_count > 0
      assign has_products = true
    elsif section.blocks.size > 0
      assign has_products = true
    endif
  -%}

  {% if has_products %}
    <div class="terra-featured-products__slider">
      <div class="terra-featured-products__viewport" data-terra-products-viewport tabindex="0" role="region" aria-label="Featured products carousel">
        <div class="terra-featured-products__grid">
          {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
            {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
              {% liquid
                assign is_sale = false
                if product.compare_at_price > product.price
                  assign is_sale = true
                endif
              %}
              <article class="terra-product-card">
                <div class="terra-product-card__media">
                  {% if is_sale and section.settings.show_badges %}<span class="terra-product-card__badge terra-product-card__badge--sale">Save</span>{% endif %}
                  {% if product.available == false and section.settings.show_badges %}<span class="terra-product-card__badge terra-product-card__badge--soldout">Sold out</span>{% endif %}
                  {% if product.available and product.tags contains 'New' and section.settings.show_badges %}<span class="terra-product-card__badge terra-product-card__badge--new">New</span>{% endif %}
                  <a href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                    {% if product.featured_image != blank %}
                      {{ product.featured_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 25vw, (min-width: 750px) 50vw, 80vw', loading: 'lazy', alt: product.featured_image.alt }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {% endif %}
                  </a>
                  {% if section.settings.show_quick_add and product.available and product.has_only_default_variant %}
                    {% form 'product', product, class: 'terra-product-card__form' %}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit">Quick add <span aria-hidden="true">+</span><span class="visually-hidden"> {{ product.title | escape }}</span></button>
                    {% endform %}
                  {% endif %}
                </div>
                <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                <p class="terra-product-card__price{% if is_sale %} terra-product-card__price--sale{% endif %}">
                  <span>{{ product.price | money }}</span>{% if is_sale %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
                </p>
              </article>
            {% endfor %}
          {% else %}
            {% for block in section.blocks limit: section.settings.products_to_show %}
              <article class="terra-product-card" {{ block.shopify_attributes }}>
                <div class="terra-product-card__media">
                  {% if block.settings.badge != 'none' and section.settings.show_badges %}<span class="terra-product-card__badge terra-product-card__badge--{{ block.settings.badge }}">{{ block.settings.badge | replace: 'soldout', 'Sold out' | escape }}</span>{% endif %}
                  <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" aria-label="View {{ block.settings.title | escape }}">
                    {% if block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 25vw, (min-width: 750px) 50vw, 80vw', loading: 'lazy', alt: block.settings.title }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {% endif %}
                  </a>
                </div>
                <h3><a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.title | escape }}</a></h3>
                <p class="terra-product-card__price{% if block.settings.compare_price != blank %} terra-product-card__price--sale{% endif %}"><span>{{ block.settings.price | escape }}</span>{% if block.settings.compare_price != blank %}<s>{{ block.settings.compare_price | escape }}</s>{% endif %}</p>
              </article>
            {% endfor %}
          {% endif %}
        </div>
      </div>
      {% if section.settings.show_progress %}
        <div class="terra-featured-products__progress" aria-hidden="true" data-terra-products-progress>
          <span></span>
        </div>
      {% endif %}
    </div>
  {% else %}
    <p class="terra-featured-products__empty">Choose a collection or add manual product cards.</p>
  {% endif %}
</section>

{% javascript %}
  (function () {
    var sliders = document.querySelectorAll('[data-terra-products-slider]');
    if (!sliders.length) return;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    for (var s = 0; s < sliders.length; s++) {
      (function (root) {
        var viewport = root.querySelector('[data-terra-products-viewport]');
        var prevBtn = root.querySelector('[data-terra-products-prev]');
        var nextBtn = root.querySelector('[data-terra-products-next]');
        var progress = root.querySelector('[data-terra-products-progress]');
        if (!viewport) return;

        var track = viewport.firstElementChild;
        var autoplayEnabled = root.getAttribute('data-autoplay') === 'true';
        var intervalMs = (parseFloat(root.getAttribute('data-interval')) || 4) * 1000;
        var timer = null;
        var canScroll = false;

        function gapOf() {
          var gap = window.getComputedStyle(track).columnGap;
          return gap ? parseFloat(gap) || 0 : 0;
        }

        function step() {
          var card = track.querySelector('.terra-product-card');
          if (!card) return viewport.clientWidth;
          return card.offsetWidth + gapOf();
        }

        function maxScroll() {
          return track.scrollWidth - viewport.clientWidth;
        }

        function updateCanScroll() {
          canScroll = maxScroll() > 2;
          if (prevBtn) prevBtn.classList.toggle('is-hidden', !canScroll);
          if (nextBtn) nextBtn.classList.toggle('is-hidden', !canScroll);
          if (progress) progress.classList.toggle('is-hidden', !canScroll);
          updateProgress();
        }

        function updateProgress() {
          if (!progress) return;
          var max = maxScroll();
          var ratio = max > 0 ? viewport.scrollLeft / max : 0;
          progress.firstElementChild.style.width = (ratio * 100).toFixed(2) + '%';
        }

        function scrollTo(scrollLeft, smooth) {
          viewport.scrollTo({ left: scrollLeft, behavior: smooth && !reduceMotion ? 'smooth' : 'auto' });
        }

        function next() {
          var max = maxScroll();
          if (viewport.scrollLeft >= max - 2) {
            scrollTo(0, true);
          } else {
            scrollTo(Math.min(viewport.scrollLeft + step(), max), true);
          }
        }

        function prev() {
          if (viewport.scrollLeft <= 2) {
            scrollTo(maxScroll(), true);
          } else {
            scrollTo(Math.max(viewport.scrollLeft - step(), 0), true);
          }
        }

        function startAutoplay() {
          if (!autoplayEnabled || reduceMotion || !canScroll) return;
          stopAutoplay();
          timer = window.setInterval(next, intervalMs);
        }

        function stopAutoplay() {
          if (timer) window.clearInterval(timer);
          timer = null;
        }

        if (prevBtn) prevBtn.addEventListener('click', function () { prev(); startAutoplay(); });
        if (nextBtn) nextBtn.addEventListener('click', function () { next(); startAutoplay(); });

        var raf = null;
        viewport.addEventListener('scroll', function () {
          if (raf) return;
          raf = window.requestAnimationFrame(function () {
            raf = null;
            updateProgress();
          });
        });

        if (autoplayEnabled && !reduceMotion) {
          root.addEventListener('mouseenter', stopAutoplay);
          root.addEventListener('mouseleave', startAutoplay);
          viewport.addEventListener('focusin', stopAutoplay);
          viewport.addEventListener('focusout', startAutoplay);
        }

        window.addEventListener('resize', function () { updateCanScroll(); });

        updateCanScroll();
        startAutoplay();
      })(sliders[s]);
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Ceramics" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all products" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Uses the selected collection when blank." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add for single-variant products", "default": true },
    { "type": "checkbox", "id": "show_badges", "label": "Show sale, sold-out, and New badges", "default": true },
    { "type": "header", "content": "Carousel" },
    { "type": "checkbox", "id": "enable_autoplay", "label": "Auto-scroll", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Auto-scroll speed (seconds)", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 },
    { "type": "checkbox", "id": "show_nav", "label": "Show previous/next arrows", "default": true },
    { "type": "checkbox", "id": "show_progress", "label": "Show scroll progress bar", "default": true },
    { "type": "header", "content": "Spacing & colors" },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 30, "max": 150, "step": 2, "unit": "px", "default": 88 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#2b2925" },
    { "type": "color", "id": "muted_color", "label": "Muted text color", "default": "#77716b" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#c4592e" }
  ],
  "blocks": [{ "type": "manual_product", "name": "Manual product card", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "title", "label": "Title", "default": "Oatmeal Carafe & Cup Set" }, { "type": "text", "id": "price", "label": "Price", "default": "$85.00" }, { "type": "text", "id": "compare_price", "label": "Compare-at price", "default": "$110.00" }, { "type": "select", "id": "badge", "label": "Badge", "default": "save", "options": [{ "value": "none", "label": "None" }, { "value": "save", "label": "Save" }, { "value": "new", "label": "New" }, { "value": "soldout", "label": "Sold out" }] }, { "type": "url", "id": "link", "label": "Product link" }] }],
  "presets": [{ "name": "Featured products", "blocks": [{ "type": "manual_product", "settings": { "title": "Oatmeal Carafe & Cup Set", "price": "$85.00", "compare_price": "$110.00", "badge": "save" } }, { "type": "manual_product", "settings": { "title": "Stoneware Salad Bowl", "price": "$64.00", "badge": "none" } }, { "type": "manual_product", "settings": { "title": "Hand-Thrown Espresso Mug", "price": "$28.00", "badge": "none" } }, { "type": "manual_product", "settings": { "title": "Sculptural Ochre Vase", "price": "$120.00", "badge": "soldout" } }, { "type": "manual_product", "settings": { "title": "Oatmeal Carafe & Cup Set", "price": "$85.00", "compare_price": "$110.00", "badge": "save" } }, { "type": "manual_product", "settings": { "title": "Stoneware Salad Bowl", "price": "$64.00", "badge": "none" } }, { "type": "manual_product", "settings": { "title": "Hand-Thrown Espresso Mug", "price": "$28.00", "badge": "none" } }, { "type": "manual_product", "settings": { "title": "Sculptural Ochre Vase", "price": "$120.00", "badge": "soldout" } }] }]
}
{% endschema %}