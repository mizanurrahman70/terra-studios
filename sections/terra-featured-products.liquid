{% style %}
  #TerraFeaturedProducts-{{ section.id }} { --terra-featured-bg: {{ section.settings.background }}; --terra-featured-text: {{ section.settings.text_color }}; --terra-featured-muted: {{ section.settings.muted_color }}; --terra-featured-accent: {{ section.settings.accent_color }}; --terra-featured-padding: {{ section.settings.padding }}px; }
{% endstyle %}

{{ 'featured-products.css' | asset_url | stylesheet_tag }}

<section id="TerraFeaturedProducts-{{ section.id }}" class="terra-featured-products">
  <div class="terra-featured-products__heading">
    <div>
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    </div>
    {% if section.settings.button_label != blank %}
      <a class="terra-featured-products__view-all" href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% elsif section.settings.collection != blank %}{{ section.settings.collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ section.settings.button_label | escape }}</a>
    {% endif %}
  </div>

  {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
    <div class="terra-featured-products__grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% liquid
          assign is_sale = false
          if product.compare_at_price > product.price
            assign is_sale = true
          endif
        %}
        <article class="terra-product-card">
          <div class="terra-product-card__media">
            {% if is_sale and section.settings.show_badges %}<span class="terra-product-card__badge terra-product-card__badge--sale">Save</span>{% endif %}
            {% if product.available == false and section.settings.show_badges %}<span class="terra-product-card__badge terra-product-card__badge--soldout">Sold out</span>{% endif %}
            {% if product.available and product.tags contains 'New' and section.settings.show_badges %}<span class="terra-product-card__badge terra-product-card__badge--new">New</span>{% endif %}
            <a href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 25vw, (min-width: 750px) 50vw, 80vw', loading: 'lazy', alt: product.featured_image.alt }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </a>
            {% if section.settings.show_quick_add and product.available and product.has_only_default_variant %}
              {% form 'product', product, class: 'terra-product-card__form' %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit">Quick add <span aria-hidden="true">+</span><span class="visually-hidden"> {{ product.title | escape }}</span></button>
              {% endform %}
            {% endif %}
          </div>
          <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
          <p class="terra-product-card__price{% if is_sale %} terra-product-card__price--sale{% endif %}">
            <span>{{ product.price | money }}</span>{% if is_sale %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
          </p>
        </article>
      {% endfor %}
    </div>
  {% elsif section.blocks.size > 0 %}
    <div class="terra-featured-products__grid">
      {% for block in section.blocks limit: section.settings.products_to_show %}
        <article class="terra-product-card" {{ block.shopify_attributes }}>
          <div class="terra-product-card__media">
            {% if block.settings.badge != 'none' and section.settings.show_badges %}<span class="terra-product-card__badge terra-product-card__badge--{{ block.settings.badge }}">{{ block.settings.badge | replace: 'soldout', 'Sold out' | escape }}</span>{% endif %}
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" aria-label="View {{ block.settings.title | escape }}">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 25vw, (min-width: 750px) 50vw, 80vw', loading: 'lazy', alt: block.settings.title }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </a>
          </div>
          <h3><a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.title | escape }}</a></h3>
          <p class="terra-product-card__price{% if block.settings.compare_price != blank %} terra-product-card__price--sale{% endif %}"><span>{{ block.settings.price | escape }}</span>{% if block.settings.compare_price != blank %}<s>{{ block.settings.compare_price | escape }}</s>{% endif %}</p>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p class="terra-featured-products__empty">Choose a collection or add manual product cards.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Ceramics" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all products" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Uses the selected collection when blank." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add for single-variant products", "default": true },
    { "type": "checkbox", "id": "show_badges", "label": "Show sale, sold-out, and New badges", "default": true },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 30, "max": 150, "step": 2, "unit": "px", "default": 88 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#2b2925" },
    { "type": "color", "id": "muted_color", "label": "Muted text color", "default": "#77716b" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#c4592e" }
  ],
  "blocks": [{ "type": "manual_product", "name": "Manual product card", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "title", "label": "Title", "default": "Oatmeal Carafe & Cup Set" }, { "type": "text", "id": "price", "label": "Price", "default": "$85.00" }, { "type": "text", "id": "compare_price", "label": "Compare-at price", "default": "$110.00" }, { "type": "select", "id": "badge", "label": "Badge", "default": "save", "options": [{ "value": "none", "label": "None" }, { "value": "save", "label": "Save" }, { "value": "new", "label": "New" }, { "value": "soldout", "label": "Sold out" }] }, { "type": "url", "id": "link", "label": "Product link" }] }],
  "presets": [{ "name": "Featured products", "blocks": [{ "type": "manual_product", "settings": { "title": "Oatmeal Carafe & Cup Set", "price": "$85.00", "compare_price": "$110.00", "badge": "save" } }, { "type": "manual_product", "settings": { "title": "Stoneware Salad Bowl", "price": "$64.00", "badge": "none" } }, { "type": "manual_product", "settings": { "title": "Hand-Thrown Espresso Mug", "price": "$28.00", "badge": "none" } }, { "type": "manual_product", "settings": { "title": "Sculptural Ochre Vase", "price": "$120.00", "badge": "soldout" } }] }]
}
{% endschema %}
