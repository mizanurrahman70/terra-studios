{% style %}
  #TerraLogoBar-{{ section.id }} {
    --terra-logobar-bg: {{ section.settings.background }};
    --terra-logobar-text: {{ section.settings.text_color }};
    --terra-logobar-muted: {{ section.settings.muted_color }};
    --terra-logobar-accent: {{ section.settings.accent_color }};
    --terra-logobar-padding: {{ section.settings.padding }}px;
  }
{% endstyle %}

{{ 'logo-bar.css' | asset_url | stylesheet_tag }}

<section id="TerraLogoBar-{{ section.id }}" class="terra-logo-bar">
  <div class="terra-logo-bar__inner">
    {% if section.settings.heading != blank %}
      <p class="terra-logo-bar__heading">{{ section.settings.heading | escape }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="terra-logo-bar__list">
        {% for block in section.blocks %}
          <span class="terra-logo-bar__item{% if section.settings.grayscale %} terra-logo-bar__item--grayscale{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
            {% endif %}
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 400 | image_tag: widths: '120, 200, 400', sizes: '140px', loading: 'lazy', alt: block.settings.title }}
              {% else %}
                <span class="terra-logo-bar__fallback">{{ block.settings.title | escape }}</span>
              {% endif %}
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </span>
        {% endfor %}
      </div>
    {% else %}
      <p class="terra-logo-bar__empty">Add your brand or partner logos here.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Logo bar",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As featured in" },
    { "type": "checkbox", "id": "grayscale", "label": "Grayscale logos until hover", "default": true },
    { "type": "header", "content": "Spacing & colors" },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 20, "max": 120, "step": 2, "unit": "px", "default": 58 },
    { "type": "color", "id": "background", "label": "Background", "default": "#f8f7f4" },
    { "type": "color", "id": "text_color", "label": "Heading color", "default": "#2b2925" },
    { "type": "color", "id": "muted_color", "label": "Text color", "default": "#77716b" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#c4592e" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "title", "label": "Name", "default": "Kinfolk", "info": "Fallback if no image uploaded" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Logo bar",
      "blocks": [
        { "type": "logo", "settings": { "title": "Kinfolk" } },
        { "type": "logo", "settings": { "title": "Monocle" } },
        { "type": "logo", "settings": { "title": "Cereal" } },
        { "type": "logo", "settings": { "title": "Kinfolk" } }
      ]
    }
  ]
}
{% endschema %}