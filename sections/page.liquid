{% style %}
  #TerraPage-{{ section.id }} {
    --terra-page-padding: {{ section.settings.padding }}px;
    --terra-page-width: {% if section.settings.width_mode == 'full' %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --terra-page-bg: {{ section.settings.background }};
    --terra-page-align: {{ section.settings.content_align }};
    --terra-page-accent: {{ section.settings.accent_color }};
    --terra-page-heading: {{ section.settings.heading_color }};
    --terra-page-muted: {{ section.settings.text_color }};
    --terra-page-h1-size: {{ section.settings.heading_size }}px;
    --terra-page-h1-weight: {{ section.settings.heading_weight }};
    --terra-page-h1-ls: {{ section.settings.heading_letter_spacing }}em;
    --terra-page-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --terra-page-body-size: {{ section.settings.body_size }}px;
    --terra-page-radius: {{ section.settings.corner_radius }}px;
    --terra-page-card-bg: {{ section.settings.card_background }};
    --terra-page-card-border: {{ section.settings.card_border_color }};
    --terra-page-card-border-w: {{ section.settings.card_border_width }}px;
    --terra-page-card-pad: {{ section.settings.card_padding }}px;
  }
{% endstyle %}

{{ 'page.css' | asset_url | stylesheet_tag }}

<div id="TerraPage-{{ section.id }}" class="terra-page">
  <div class="terra-page__inner{% if section.settings.enable_card %} terra-page__card{% endif %}">
    {% if section.settings.show_eyebrow and section.settings.eyebrow != blank %}
      <p class="terra-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.show_title %}
      <h1>{{ page.title }}</h1>
    {% endif %}

    {% if section.settings.show_author and page.author != blank %}
      <p class="terra-page__meta">{{ page.author | escape }}{% if page.published_at != blank %} &middot; {{ page.published_at | date: '%B %d, %Y' }}{% endif %}</p>
    {% endif %}

    {% if section.settings.show_divider %}
      <hr class="terra-page__divider{% if section.settings.content_align == 'center' %} terra-page__divider--center{% endif %}" role="presentation">
    {% endif %}

    {% if section.settings.show_content and page.content != blank %}
      <div class="terra-page__content">{{ page.content }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": false },
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author and date", "default": false },
    { "type": "checkbox", "id": "show_divider", "label": "Show divider under header", "default": true },
    { "type": "checkbox", "id": "show_content", "label": "Show page content", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "width_mode", "label": "Content width mode", "default": "full", "options": [ { "value": "full", "label": "Full width" }, { "value": "custom", "label": "Custom width" } ] },
    { "type": "range", "id": "max_width", "label": "Content width (custom)", "min": 480, "max": 1200, "step": 20, "unit": "px", "default": 820 },
    { "type": "select", "id": "content_align", "label": "Content alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 30, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Title size", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 46 },
    { "type": "select", "id": "heading_weight", "label": "Title weight", "default": "800", "options": [ { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ] },
    { "type": "select", "id": "heading_letter_spacing", "label": "Title letter-spacing", "default": "-0.055", "options": [ { "value": "-0.06", "label": "Extra tight" }, { "value": "-0.055", "label": "Tight (default)" }, { "value": "-0.04", "label": "Compact" }, { "value": "-0.02", "label": "Default" }, { "value": "0", "label": "Normal" }, { "value": "0.02", "label": "Wide" } ] },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 9, "max": 16, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 13, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Border & radius" },
    { "type": "checkbox", "id": "enable_card", "label": "Wrap content in a card", "default": false },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 56 },
    { "type": "checkbox", "id": "show_card_border", "label": "Show card border", "default": true },
    { "type": "range", "id": "card_border_width", "label": "Card border width", "min": 1, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "color", "id": "card_border_color", "label": "Card border color", "default": "#e5ddd1" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#2b2925" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#77716b" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#c4592e" }
  ],
  "presets": [{ "name": "t:general.page" }]
}
{% endschema %}