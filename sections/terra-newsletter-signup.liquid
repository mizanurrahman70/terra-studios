{% style %}
  #TerraNewsletter-{{ section.id }} { --terra-newsletter-bg: {{ section.settings.background }}; --terra-newsletter-text: {{ section.settings.text_color }}; --terra-newsletter-muted: {{ section.settings.muted_color }}; --terra-newsletter-accent: {{ section.settings.accent_color }}; --terra-newsletter-padding: {{ section.settings.padding }}px; }
{% endstyle %}

{{ 'newsletter-signup.css' | asset_url | stylesheet_tag }}

<section id="TerraNewsletter-{{ section.id }}" class="terra-newsletter">
  <div class="terra-newsletter__inner">
    {% if section.settings.eyebrow != blank %}<p class="terra-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape | newline_to_br }}</h2>{% endif %}
    {% if section.settings.text != blank %}<div class="terra-newsletter__text">{{ section.settings.text | escape | newline_to_br }}</div>{% endif %}
    {% form 'customer', class: 'terra-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
      <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% endif %}" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="{{ section.settings.placeholder | escape }}" required>
      <button type="submit">{{ section.settings.button_label | escape }}</button>
      {% if form.errors %}<p class="terra-newsletter__message terra-newsletter__message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{% endif %}
      {% if form.posted_successfully? %}<p class="terra-newsletter__message">{{ section.settings.success_message | escape }}</p>{% endif %}
    {% endform %}
    {% content_for 'blocks' %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter signup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay connected" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Be the first to hear about Batch\n05" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sign up for early catalog access, workshop journals, and private collection drops.\nNever spam, unsubscribe anytime." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you for subscribing." },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 40, "max": 170, "step": 2, "unit": "px", "default": 98 },
    { "type": "color", "id": "background", "label": "Background", "default": "#f8f7f4" },
    { "type": "color", "id": "text_color", "label": "Heading color", "default": "#2b2925" },
    { "type": "color", "id": "muted_color", "label": "Text color", "default": "#77716b" },
    { "type": "color", "id": "accent_color", "label": "Button color", "default": "#c4592e" }
  ],
  "blocks": [{ "type": "@theme" }],
  "max_blocks": 8,
  "presets": [{ "name": "Newsletter signup" }]
}
{% endschema %}
