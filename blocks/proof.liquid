
{% doc %}
  Renders a proof point statement with a bold heading and supporting text.

  @example
  {% content_for 'block', type: 'proof', id: 'proof' %}
{% enddoc %}

<div class="terra-hero__proof-item" {{ block.shopify_attributes }}>
  <strong>{{ block.settings.heading | escape }}</strong>
  <span>{{ block.settings.text | escape }}</span>
</div>

{% schema %}
{
  "name": "Proof point",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Lead-Free Clay"
    }
  ],
  "presets": [{ "name": "Proof point" }]
}
{% endschema %}